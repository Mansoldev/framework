---
import '../styles/website.scss';
import themeManifest from '../../../src/themes/manifest.json';

if (!import.meta.env.PROD) {
  await import('../../../src/main.scss');
}

interface Props {
  title?: string;
}

const { title = "System Style Framework" } = Astro.props;
const themes = themeManifest.themes;
const defaultTheme = themes[0]?.name;
---

<html lang="es" data-palette={defaultTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    {import.meta.env.PROD && <link rel="stylesheet" href="/framework.css" />}
  </head>

  <body>
    <header class="topbar">
      <h1 class="topbar__title">Mansoldev Framework CSS</h1>
      <div class="topbar__actions">
        <button id="themeToggle" class="mc-btn mc-btn--secondary">
          🌙 Oscuro
        </button>
        <select id="styleSelect" class="select">
          {themes.map((theme) => (
            <option value={theme.name}>{theme.label}</option>
          ))}
        </select>
      </div>
    </header>

    <div class="layout">
      <aside class="sidebar">
        <div class="sidebar__search">
          🔍
          <input type="text" placeholder="Buscar..." />
        </div>
        <nav class="nav">
          <a href="/">Index</a>
          <a href="/htmltags">Html tags</a>
        </nav>
      </aside>

      <main class="content">
        <slot />
      </main>
    </div>

    <script type="module">
      const root = document.documentElement;
      const btn = document.getElementById('themeToggle');
      const paletteSelect = document.getElementById('styleSelect');

      root.dataset.palette = paletteSelect.value;

      paletteSelect.addEventListener('change', () => {
        root.dataset.palette = paletteSelect.value;
      });

      btn.addEventListener('click', () => {
        const isDark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;

        if (isDark) {
          root.dataset.theme = 'light';
          btn.textContent = '🌙 Modo Oscuro';
        } else {
          root.dataset.theme = 'dark';
          btn.textContent = '☀️ Modo Claro';
        }
      });
    </script>
  </body>
</html>