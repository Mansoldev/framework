---
import MainLayout from '../layouts/MainLayout.astro';
import themeManifest from '../../../src/themes/manifest.json';

const palettes = themeManifest.themes;
const shadeLabels = ['50', '100', '200', '300', '400', '500', '600', '700', '800', '900', '950'];
---

<MainLayout title="Color palette">
  <header class="hero">
    <div>
      <h1>Color palette</h1>
      <p>
        Paletas completas inspiradas en Material Design, Bootstrap, Vuetify y Tailwind, expresadas en OKLCH para mantener mejor
        contraste y una escala consistente.
      </p>
    </div>
    <aside class="hero-note">
      <h2>Principios</h2>
      <p>
        Cada tema expone una escala completa de marcas, acentos y neutrales con tonos 50–950, siguiendo la convención que usan
        los frameworks modernos.
      </p>
    </aside>
  </header>

  <section class="palette-grid">
    {palettes.map((theme) => (
      <article class="palette-card">
        <header class="palette-card__header">
          <h2>{theme.label}</h2>
          <p>{theme.description}</p>
        </header>

        <div class="palette-card__body">
          <div class="swatch-group">
            <h3 class="swatch-group__title">Brand</h3>
            <div class="swatch-row">
              {shadeLabels.map((shade) => (
                <div class="swatch">
                  <div class="swatch__chip" style={`background: ${theme.colors.brand[shade]};`} aria-label={`${theme.label} brand ${shade}`} />
                  <div class="swatch__meta">{shade}</div>
                </div>
              ))}
            </div>
          </div>

          <div class="swatch-group">
            <h3 class="swatch-group__title">Accent</h3>
            <div class="swatch-row">
              {shadeLabels.map((shade) => (
                <div class="swatch">
                  <div class="swatch__chip" style={`background: ${theme.colors.accent[shade]};`} aria-label={`${theme.label} accent ${shade}`} />
                  <div class="swatch__meta">{shade}</div>
                </div>
              ))}
            </div>
          </div>

          <div class="swatch-group">
            <h3 class="swatch-group__title">Neutral</h3>
            <div class="swatch-row">
              {['0', '50', '100', '200', '300', '400', '500', '600', '700', '800', '900', '950', '1000'].map((shade) => (
                <div class="swatch">
                  <div class="swatch__chip" style={`background: ${theme.colors.neutral[shade]};`} aria-label={`${theme.label} neutral ${shade}`} />
                  <div class="swatch__meta">{shade}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </article>
    ))}
  </section>
</MainLayout>
