---
import MainLayout from '../layouts/MainLayout.astro';
import themeManifest from '../../../src/themes/manifest.json';

const palettes = themeManifest.themes;
const defaultShadeOrder = ['50', '100', '200', '300', '400', '500', '600', '700', '800', '900', '950'];
const neutralShadeOrder = ['0', '50', '100', '200', '300', '400', '500', '600', '700', '800', '900', '950', '1000'];
---

<MainLayout title="Color palette">
  <header class="hero">
    <div>
      <h1>Color palette</h1>
      <p>
        Paletas completas inspiradas en Material Design, Bootstrap, Vuetify y Tailwind, expresadas en OKLCH para mantener mejor
        contraste y una escala consistente.
      </p>
    </div>
    <aside class="hero-note">
      <h2>Principios</h2>
      <p>
        Cada tema expone familias de color reales con tonos 50–950 y roles semánticos que se asignan a la escala primaria, de éxito,
        advertencia, peligro y neutral.
      </p>
    </aside>
  </header>

  <section class="palette-grid">
    {palettes.map((theme) => (
      <article class="palette-card">
        <header class="palette-card__header">
          <h2>{theme.label}</h2>
          <p>{theme.description}</p>
        </header>

        <div class="palette-card__body">
          {Object.entries(theme.colors).map(([groupName, group]) => (
            <div class="swatch-group">
              <h3 class="swatch-group__title">{groupName}</h3>
              <div class="swatch-row">
                {(groupName === 'slate' ? neutralShadeOrder : defaultShadeOrder).map((shade) => {
                  const value = group[shade];
                  if (!value) return null;

                  return (
                    <div class="swatch">
                      <div class="swatch__chip" style={`background: ${value};`} aria-label={`${theme.label} ${groupName} ${shade}`} />
                      <div class="swatch__meta">{shade}</div>
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </article>
    ))}
  </section>
</MainLayout>
